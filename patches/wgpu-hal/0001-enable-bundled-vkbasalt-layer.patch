diff --git a/src/vulkan/instance.rs b/src/vulkan/instance.rs
--- a/src/vulkan/instance.rs
+++ b/src/vulkan/instance.rs
@@ -685,6 +685,19 @@
         let has_nv_optimus = find_layer(&instance_layers, c"VK_LAYER_NV_optimus").is_some();
 
         let has_obs_layer = find_layer(&instance_layers, c"VK_LAYER_OBS_HOOK").is_some();
 
         let mut layers: Vec<&'static CStr> = Vec::new();
+
+        // Glue 5: vkBasalt is packaged in this Android app's own native-library
+        // directory. Android does not support implicit layers, so the application
+        // must explicitly name the app-local layer in VkInstanceCreateInfo.
+        // Only enable it after Glue 5 has validated the selected preset and opted in.
+        #[cfg(target_os = "android")]
+        if std::env::var_os("GLUE5_VULKAN_RESHADE").is_some() {
+            let vkbasalt_name = c"VK_LAYER_VKBASALT_post_processing";
+            if find_layer(&instance_layers, vkbasalt_name).is_some() {
+                layers.push(vkbasalt_name);
+                log::info!("Glue 5: enabling bundled Vulkan post-processing layer");
+            } else {
+                log::warn!("Glue 5: bundled Vulkan post-processing layer is not visible to the Android loader");
+            }
+        }
 
         let has_debug_extension = extensions.contains(&ext::debug_utils::NAME);
