diff --git a/wgpu-hal/src/vulkan/instance.rs b/wgpu-hal/src/vulkan/instance.rs
--- a/wgpu-hal/src/vulkan/instance.rs
+++ b/wgpu-hal/src/vulkan/instance.rs
@@ -689,6 +689,19 @@
         let mut layers: Vec<&'static CStr> = Vec::new();
 
+        // Glue 5: opt in to the app-packaged Android ReShade FX Vulkan layer.
+        // Keep the renderer unchanged when ReShade is disabled or unavailable.
+        #[cfg(target_os = "android")]
+        if std::env::var_os("GLUE5_VULKAN_RESHADE").is_some() {
+            const RESHADE_LAYER: &CStr = c"VK_LAYER_VKBASALT_post_processing";
+            if find_layer(&instance_layers, RESHADE_LAYER).is_some() {
+                layers.push(RESHADE_LAYER);
+                log::info!("Vulkan: enabled app-packaged ReShade FX layer");
+            } else {
+                log::warn!("Vulkan: ReShade was requested but its Vulkan layer is not packaged");
+            }
+        }
+
         let has_debug_extension = extensions.contains(&ext::debug_utils::NAME);
